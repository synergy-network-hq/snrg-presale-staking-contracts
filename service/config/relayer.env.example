# Canonical networks
BASE_RPC_URL=https://YOUR_BASE_RPC
ETHEREUM_RPC_URL=https://YOUR_ETHEREUM_RPC

# Deployed application addresses
BASE_STAKING_ADDRESS=0xREPLACE
BASE_STAKING_DEPLOY_BLOCK=0
REWARD_GATEWAY_ADDRESS=0xREPLACE
ATTESTOR_REGISTRY_ADDRESS=0xREPLACE
ATTESTATION_VERIFIER_ADDRESS=0xREPLACE

# Ethereum gas payer only. This account has no governance, attestor, or reward-issuer role.
# Keep the password in a separate root-readable file, never in this environment file.
ETHEREUM_RELAYER_KEYSTORE_PATH=/etc/synergy/sxcp-staking/relayer-keystore.json
ETHEREUM_RELAYER_KEYSTORE_PASSWORD_FILE=/etc/synergy/sxcp-staking/relayer-keystore.password
ETHEREUM_CONFIRMATIONS=2

# Persistent relayer state
# This must remain under the systemd unit's dedicated writable path.
SQLITE_DB_PATH=/var/lib/synergy-sxcp-staking/staking-relayer.db
RELAYER_POLL_MS=12000
BASE_SCAN_BATCH_SIZE=1500
ATTESTATION_TTL_SECONDS=3600
RELAYER_HEALTH_HOST=127.0.0.1
RELAYER_HEALTH_PORT=9460

# Three independent EIP-712 attestors; on-chain threshold must be 2-of-3.
ATTESTOR_SET_CONFIG=/etc/synergy/sxcp-staking/attestor-set.json
ATTESTOR_TIMEOUT_MS=20000

# Mutual TLS client identity used to reach attestors.
MTLS_CA_CERT=/etc/synergy/sxcp-staking/pki/ca.crt
MTLS_CLIENT_CERT=/etc/synergy/sxcp-staking/pki/relayer.crt
MTLS_CLIENT_KEY=/etc/synergy/sxcp-staking/pki/relayer.key
