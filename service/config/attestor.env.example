BASE_RPC_URL=https://REPLACE_WITH_BASE_MAINNET_RPC
ETHEREUM_RPC_URL=https://REPLACE_WITH_ETHEREUM_MAINNET_RPC
BASE_STAKING_ADDRESS=0xREPLACE
BASE_STAKING_DEPLOY_BLOCK=0
ATTESTOR_REGISTRY_ADDRESS=0xREPLACE
ATTESTATION_VERIFIER_ADDRESS=0xREPLACE
ATTESTOR_EPOCH_ID=1
ATTESTOR_KEYSTORE_PATH=/etc/synergy/sxcp-staking/attestor.json
ATTESTOR_KEYSTORE_PASSWORD_FILE=/etc/synergy/sxcp-staking/attestor.password
ATTESTOR_BIND_HOST=127.0.0.1
ATTESTOR_PORT=9443
MTLS_CA_CERT=/etc/synergy/sxcp-staking/pki/ca.crt
MTLS_SERVER_CERT=/etc/synergy/sxcp-staking/pki/attestor.crt
MTLS_SERVER_KEY=/etc/synergy/sxcp-staking/pki/attestor.key
