# Explicit broadcast gate. Production scripts print configuration when false.
BROADCAST=false

# Dedicated deployment gas payer. Inject from an encrypted secret store at execution time.
# It receives no governance or operational role.
DEPLOYER_PRIVATE_KEY=

# Shared governance Safe/multisig; never a personal EOA.
GOVERNANCE_SAFE=0x0000000000000000000000000000000000000000

# Base mainnet (8453)
BASE_RPC_URL=
BASESCAN_API_KEY=
BASE_SAFT_VOUCHER=0xBd7a74C6A6Aba6eFc0211C4F90bE70AFc081f489
BASE_SAFT_ENTITLEMENT_DECIMALS=0
BASE_UNLOCKED_SNRG=0xb695EB367f61D0Af0baAd5d8D96c8aC2A594058F
BASE_LOCKED_SNRG=0x7E6B6D10d6dCDEf7FDF8EAA10717eFB3eb6E3101
BASE_ENROLLMENT_OPENS_AT=0
BASE_ENROLLMENT_CLOSES_AT=0
BASE_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
BASE_STAKING_DEPLOY_BLOCK=0

# Ethereum mainnet (1)
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=
ETHEREUM_PRESALE_VOUCHER=0xF913ddCe2Bf4FCA896332086c08B90A1A06fc7A9
ETH_ENROLLMENT_OPENS_AT=0
ETH_ENROLLMENT_CLOSES_AT=0
REWARD_VOUCHER_BASE_URI=

# Conventional EIP-712 attestation epoch; all three must be independent EOAs.
ATTESTATION_EPOCH=1
ATTESTATION_THRESHOLD=2
ATTESTOR_1=0x0000000000000000000000000000000000000000
ATTESTOR_2=0x0000000000000000000000000000000000000000
ATTESTOR_3=0x0000000000000000000000000000000000000000

# Operational roles; normally the Governance Safe or purpose-limited multisig.
BASE_PAUSER=0x0000000000000000000000000000000000000000
BASE_KEEPER=0x0000000000000000000000000000000000000000
ETH_PAUSER=0x0000000000000000000000000000000000000000
ETH_KEEPER=0x0000000000000000000000000000000000000000
REWARD_PAUSER=0x0000000000000000000000000000000000000000
REWARD_METADATA_ADMIN=0x0000000000000000000000000000000000000000

# Supply a secure keystore/HSM signer at execution time. Never commit a private key.
