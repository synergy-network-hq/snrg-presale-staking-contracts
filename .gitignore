# ============================================================
# SNRG Presale Staking
# Git ignore rules for Solidity / Foundry development
# ============================================================

# Secrets / environment files
.env
.env.*
!.env.example
!deploy.env.example

# Private keys / keystores / credentials
*.key
*.pem
*.p12
*.pfx
keystore/
keystores/
secrets/
credentials/

# Foundry
out/
cache/
broadcast/

# Forge coverage / profiling output
coverage/
lcov.info
*.lcov

# Security scanner output
security-reports/

# Common standalone scanner outputs
report.md
report.sarif
slither-report.*
mythril-report.*
wake-report.*
aderyn-report.*

# Node / Hardhat tooling (if used alongside Foundry)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
artifacts/
typechain/
typechain-types/

# Python tooling
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Logs / temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# Archives / generated packages
*.zip
*.tar
*.tar.gz
*.tgz

# Local deployment / verification artifacts
deployments/local/
deployments/dev/
verification-cache/

# Intentionally NOT ignored:
# lib/           - Foundry dependencies may be committed or Git submodules.
# remappings.txt - Required for reproducible Foundry builds.
# foundry.toml   - Required project configuration.
# contracts/     - Production Solidity source.
# test/          - Tests should normally be committed.
# script/        - Deployment scripts should normally be committed.
# README.md      - Project documentation.
